# Only the application code, the lock and model_profiles.yml belong in the image.
# Everything below is either build tooling, local state or a secret.

.git
.github
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage
htmlcov

tests
docs
deploy
*.md

Dockerfile
.dockerignore
docker-compose*.yml

# config.py reads a .env next to it: none may reach the image.
.env
.env.*
*.env

recordings
*.wav
*.log

# Repository metadata the service never reads.
.gitignore
release-please-config.json
.release-please-manifest.json
