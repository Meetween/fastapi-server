# Installed as /etc/systemd/system/meetween-fastapi.service. See deploy/README.md.
[Unit]
Description=Meetween FastAPI server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
# model_profiles.yml is resolved relative to the working directory.
WorkingDirectory=/mnt/vdc/meetween/fastapi-server
EnvironmentFile=/etc/meetween/fastapi.env
ExecStart=/mnt/vdc/meetween/fastapi-server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3
# SIGINT lets uvicorn run the shutdown hooks: scheduler, sessions, MongoDB client.
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
