# Template of /etc/meetween/<env>.env, root:root 0600, one file per environment. bootstrap.sh
# copies it once and fills the keys marked "per env"; it never overwrites an existing file.
# The docker client reads it with --env-file: one KEY=value per line, no quotes, no export,
# a comment only on a line of its own. Every key is a field of Settings in config.py; the image
# carries model_profiles.yml, so MODEL_PROFILES_PATH stays at its default.

# Per env: dev 8011, prod 8012. Both containers share the host network, so the ports must
# differ. 8001 belongs to the service started by hand and is not used here.
PORT=8011

MONGO_URI=mongodb://localhost:27017
# Per env: dev meetween_dev, prod meetween. Separate databases keep test users, meetings and
# summaries out of production.
MONGO_DB_NAME=meetween_dev

# Per env: /mnt/vdc/meetween/<env>/recordings, bind mounted at the same path. Each process runs
# the 02:00 retention cleanup over its own tree; a shared tree would be cleaned twice and one
# environment would delete the recordings of the other.
RECORDINGS_BASE_PATH=/mnt/vdc/meetween/dev/recordings

# Per env: bootstrap.sh writes the output of `openssl rand -hex 32`, generated on the VM. A
# separate secret means a token issued by dev is never accepted by prod. Never leave it empty
# or at the default of config.py: anyone could sign a valid token.
JWT_SECRET_KEY=
ENABLE_AUTH=true

MODEL_PROFILE=voxtral_mini_3b_2507
# The Jitsi web frontend this environment links meetings to. Empty: the token endpoint returns
# no join URL, only the token.
JITSI_MEET_BASE_URL=
LOG_LEVEL=INFO
