# Template of /etc/meetween/<env>.env, root:root 0600, one file per environment. bootstrap.sh
# copies it once and fills the keys marked "per env"; it never overwrites an existing file.
# The docker client reads it with --env-file: one KEY=value per line, no quotes, no export,
# a comment only on a line of its own. Every key is a field of Settings in config.py; the image
# carries model_profiles.yml, so MODEL_PROFILES_PATH stays at its default.

# Per env: dev 8011, prod 8012. Both containers share the host network, so the ports must
# differ. 8001 belongs to the service started by hand and is not used here.
PORT=8011

MONGO_URI=mongodb://localhost:27017
# Per env: dev meetween_dev, prod meetween. Separate databases keep test users, meetings and
# summaries out of production.
MONGO_DB_NAME=meetween_dev

# Per env: /mnt/vdc/meetween/<env>/recordings, bind mounted at the same path. Each process runs
# the 02:00 retention cleanup over its own tree; a shared tree would be cleaned twice and one
# environment would delete the recordings of the other.
RECORDINGS_BASE_PATH=/mnt/vdc/meetween/dev/recordings

# Per env: bootstrap.sh writes the output of `openssl rand -hex 32`, generated on the VM. A
# separate secret means a token issued by dev is never accepted by prod. Never leave it empty
# or at the default of config.py: anyone could sign a valid token.
JWT_SECRET_KEY=
ENABLE_AUTH=true
# Shared bearer Jigasi sends on participant updates and translation.
# Leave empty only when ENABLE_AUTH=false. While auth is on, an empty value
# rejects those calls.
JIGASI_MEETWEEN_API_KEY=
# Shared bearer the virtual participant worker sends to /api/chat and to
# /api/meetings/{id}/chat-messages. It opens no other route.
# Leave empty if no worker runs. While auth is on, an empty value rejects the worker's calls.
VP_MEETWEEN_API_KEY=
# Display name suffix of a virtual participant, the same value as the worker's
# VP_BOT_NAME_SUFFIX. Its audio is not transcribed. Empty transcribes everyone.
VP_BOT_NAME_SUFFIX=(bot)

MODEL_PROFILE=voxtral_mini_3b_2507
# The Jitsi web frontend this environment links meetings to. Empty: the token endpoint returns
# no join URL, only the token.
JITSI_MEET_BASE_URL=
LOG_LEVEL=INFO

# Virtual participants. /api/virtual-participants forwards to vp-worker, which owns the browsers
# and the media. The container shares the host network, so the worker and the Prosody HTTP port
# are reached on loopback.
VP_WORKER_URL=http://127.0.0.1:18200
# Per env, set by hand: bootstrap.sh does not fill it. Use the output of `openssl rand -hex 32`
# and give the worker the same value. While it is empty the route answers 503.
VP_WORKER_SECRET=
# Prosody HTTP port. It needs mod_muc_size (XMPP_MODULES=muc_size on the Jitsi side); the room
# is looked up there before a bot joins it.
VP_PROSODY_HTTP_URL=http://127.0.0.1:15280
VP_XMPP_DOMAIN=meet.jitsi
# true: refuse a bot in a room with no human in it.
VP_REQUIRE_HUMAN=true
VP_MAX_BOTS_PER_ROOM=2
# Comma separated display names that do not count as a human, matched case insensitively. Do
# not empty it: a presence check that fails open let a transcriber count as a human.
VP_SERVICE_NAMES=Transcriber,Recorder,Jibri,Jigasi
VP_REQUEST_TIMEOUT_S=10

# Agentar. Feature flags are served by GET /api/auth/config. All three are off by default.
# Open sign up on a public link needs the per user quotas below.
SIGNUP_ENABLED=false
EMAIL_ENABLED=false
CALENDAR_ENABLED=false
# Signs Jitsi room tokens, shared with Prosody as JWT_APP_SECRET. Use `openssl rand -hex 32`, a
# different value from JWT_SECRET_KEY. While it is empty the token routes answer 503.
JWT_JITSI_SECRET_KEY=
# How vp-worker reaches this API (the worker's VP_MEETWEEN_API_URL). While it is empty, sending
# an Agentar answers 503. The worker's events use VP_MEETWEEN_API_KEY.
VP_MEETWEEN_API_URL=
# S3 compatible store for knowledge base files, pictures and report exports. Empty endpoint
# means AWS. While the bucket or a key is empty the Agentar file routes answer 503.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults shown. Meetings per UTC day, files and bytes per user, and the lifecycle tick.
AGENTAR_FILE_MAX_BYTES=10485760
AGENTAR_USER_MAX_FILES=20
AGENTAR_USER_MAX_BYTES=104857600
AGENTAR_PICTURE_MAX_BYTES=5242880
AGENTAR_MEETINGS_PER_DAY=10
AGENTAR_TICK_SECONDS=30
AGENTAR_GRACE_MINUTES_DEFAULT=15
SIGNUP_RATE_PER_IP=5
SIGNUP_RATE_PER_EMAIL=3
# true on a deployment that runs Agentar: startup then refuses an empty VP_MEETWEEN_API_KEY.
AGENTAR_ENABLED=false
# Agentars live at once across all users. One GPU renders one Ditto session.
AGENTAR_MAX_LIVE_TOTAL=1
# First claims of a new room per user and UTC day.
ROOM_CLAIMS_PER_DAY=20
# Failed logins per window per address and per email, and per address over all emails.
LOGIN_FAIL_LIMIT=10
LOGIN_FAIL_WINDOW_MINUTES=15
LOGIN_FAIL_IP_LIMIT=50
# Addresses of the reverse proxy in front of this API, comma separated. X-Real-IP is trusted as
# the client address only from these peers. Empty: the peer address is always used.
TRUSTED_PROXY_IPS=
