# Installed as /etc/meetween/fastapi.env, root:root 0600. Read by the systemd unit.
# Every key is a field of Settings in config.py. The release checkout carries no .env file:
# this is the only configuration source of the service.
MODEL_PROFILE=voxtral_mini_3b_2507
MODEL_PROFILES_PATH=model_profiles.yml
RECORDINGS_BASE_PATH=/mnt/recordings
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=meetween
ENABLE_AUTH=true
JWT_SECRET_KEY=change-me
JITSI_MEET_BASE_URL=
LOG_LEVEL=INFO
