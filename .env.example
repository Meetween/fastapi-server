# Meetween FastAPI Server — reference for environment variables
#
# pydantic-settings reads these from the process environment when `config` loads.
# A `.env` file is NOT loaded automatically unless you use python-dotenv (or similar)
# before importing the app, or a process manager that injects env from a file.
#
# Shell:   export MODEL_PROFILE=qwen25_omni
# Uvicorn: env vars must be set in the same environment as the worker process.

# =============================================================================
# Model profile (recommended primary knob)
# =============================================================================
# Must match a key under `profiles:` in `model_profiles.yml`.
# After base + env Triton values are built, `config.model_post_init` merges
# `profiles.<MODEL_PROFILE>.triton` on top (only keys present in YAML).
#
# Valid keys in the shipped file: speechlmm | qwen25_omni | voxtral_mini_3b_2507
# Default in code if unset: speechlmm (see `Settings.model_profile` in config.py)
MODEL_PROFILE=qwen25_omni

# Path to profile YAML. Relative paths resolve next to `config.py`.
MODEL_PROFILES_PATH=model_profiles.yml

# =============================================================================
# Triton (nested settings — each has env= in `TritonSettings`)
# =============================================================================
# These form the base layer before `model_profiles.yml` overrides.
# Example: with MODEL_PROFILE=qwen25_omni, the profile sets url, model_name,
# prompt_protocol, caption_chars — your TRITON_* env vars still apply for any
# field the profile does not define (or merge with profile if you customize YAML).
TRITON_URL=http://localhost:9000
TRITON_MODEL_NAME=qwen25_omni
TRITON_TIMEOUT=1800
TRITON_MAX_CONTEXT_CHARS=300000
TRITON_MAX_HISTORY_TURNS=400
TRITON_MAX_HISTORY_CHARS=600000
TRITON_PROMPT_PROTOCOL=speechlmm_plain
TRITON_CAPTION_CHARS=60

# =============================================================================
# Application (top-level `Settings` — loaded from env by pydantic-settings)
# =============================================================================
# Field names → typical env names (uppercase). Defaults match config.py.
#
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
#
# RECORDINGS_BASE_PATH=/mnt/recordings
# RECORDING_FORMAT=wav
# MIN_CATCHUP_DURATION_SECONDS=60
# RECORDING_RETENTION_DAYS=7
#
# Optional branding (rarely need to override):
# APP_NAME=Meetween FastAPI Server
# APP_VERSION=1.0.0

# =============================================================================
# Running
# =============================================================================
# python main.py     → uses HOST and PORT from env if set, else config defaults
# uvicorn main:app --host 0.0.0.0 --port 8000
#   → bind flags override uvicorn only; Settings.host/port still affect `python main.py`
